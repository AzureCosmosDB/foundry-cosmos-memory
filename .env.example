# These values are populated automatically in the azd environment by `azd up`.
# Copy this file to .env only when using pre-existing Azure resources.

COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_DATABASE=ai_memory

FOUNDRY_ENDPOINT=https://<your-account>.services.ai.azure.com
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<project>
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o-mini

FOUNDRY_AGENT_NAME=cosmos-memory-sample-agent
FOUNDRY_AGENT_VERSION=1
